# ─── PinPoint Server Environment Variables ───
# Copy this file to .env and fill in your values

# Node Environment
NODE_ENV=development
PORT=4000
NODE_OPTIONS=--dns-result-order=ipv4first

# ─── PostgreSQL Database ───
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pinpoint_dev
DB_USER=postgres
DB_PASSWORD=your_password_here
# Alternative: use a single connection URL
# DATABASE_URL=postgres://user:password@localhost:5432/pinpoint_dev

# ─── Redis (Cache + Queue + Socket.io) ───
REDIS_URL=redis://localhost:6379
# For Upstash (serverless Redis):
# REDIS_URL=rediss://default:password@us1-able-redis-12345.upstash.io:6379

# ─── JWT Auth ───
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-at-least-32-chars-long
# Comma-separated list of allowed origins for CORS
APP_URL=http://localhost:3000

# ─── API Keys ───
# Encryption key for storing API keys (32 hex chars)
API_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ─── Email Driver (smtp | resend) ───
EMAIL_DRIVER=smtp
EMAIL_FROM=yourname@gmail.com

# ─── SMTP (Gmail) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@gmail.com
SMTP_PASS=your-gmail-app-password

# ─── Resend (Alternative) ───
# Switch EMAIL_DRIVER=resend and set RESEND_API_KEY to use Resend instead
RESEND_API_KEY=re_xxxxx

# ─── Object Storage (S3-compatible) ───
# Supabase Storage: STORAGE_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
#                   STORAGE_REGION=ap-south-1
# Cloudflare R2:    STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#                   STORAGE_REGION=auto
STORAGE_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY_ID=your-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-secret-access-key
STORAGE_BUCKET_NAME=pinpoint-screenshots
STORAGE_PUBLIC_URL=https://<ref>.supabase.co/storage/v1/object/public/pinpoint-screenshots

# ─── Stripe (Billing) ───
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRO_PRICE_ID=price_xxxxx
STRIPE_BUSINESS_PRICE_ID=price_xxxxx

# ─── Rate Limiting ───
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── Puppeteer (Server Screenshots) ───
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
